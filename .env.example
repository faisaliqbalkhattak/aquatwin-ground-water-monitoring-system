# Public HiveMQ Cloud connection details already used by the AquaTwin firmware.
MQTT_HOST=6a3cba0faab347c9a1a0c5afcfbd3ca3.s1.eu.hivemq.cloud
MQTT_PORT=8883

# Create these in HiveMQ Cloud > Access Management. Never commit real values.
MQTT_USERNAME=
MQTT_PASSWORD=

# Frozen multi-well subscription contract. Publishers replace + with their well_id.
MQTT_TOPIC=aquatwin/well/+/telemetry

# Dashboard warns when no valid message arrives for this many seconds.
MQTT_STALE_TIMEOUT=10
